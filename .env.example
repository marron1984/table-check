# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tablecheck_crm"

# TableCheck API
TABLECHECK_API_BASE_URL="https://api.tablecheck.com/v2"
TABLECHECK_API_KEY="your-api-key"
TABLECHECK_API_SECRET="your-api-secret"
TABLECHECK_FRANCHISE_ID="your-franchise-id"

# Sync API
TABLECHECK_SYNC_WEBHOOK_SECRET="your-webhook-secret"

# Server
PORT=4000
NODE_ENV=development

# Auth / Session
JWT_SECRET="your-jwt-secret"
SESSION_EXPIRY_HOURS=24
